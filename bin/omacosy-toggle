#!/bin/sh
set -eu
mode="${1:-toggle}"
case "$mode" in
 toggle) if [ -f /Users/satan/.local/state/omacosy-trial/paused ]; then mode=on; else mode=off; fi ;;
esac
case "$mode" in
 off) exec /Users/satan/.local/bin/omacosy-trial-pause ;;
 on) exec /Users/satan/.local/bin/omacosy-trial-resume ;;
 *) echo 'usage: omacosy-toggle [on|off|toggle]' >&2; exit 2 ;;
esac
