{
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "Edge: Command Tab cycles browser tabs",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": {
                    "mandatory": [
                      "command",
                      "shift"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "tab",
                    "modifiers": [
                      "left_control",
                      "left_shift"
                    ]
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "tab",
                    "modifiers": [
                      "left_control"
                    ]
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Ghostty: Command Tab cycles windows on the current display and workspace",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": {
                    "mandatory": [
                      "command",
                      "shift"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "shell_command": "/Users/satan/.local/bin/omacosy-cycle ghostty-prev"
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.mitchellh\\.ghostty$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "shell_command": "/Users/satan/.local/bin/omacosy-cycle ghostty-next"
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.mitchellh\\.ghostty$"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Caps Lock: tap toggles Caps Lock; hold with another key sends Super",
            "manipulators": [
              {
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_command",
                    "modifiers": [
                      "left_control",
                      "left_option"
                    ]
                  }
                ],
                "type": "basic",
                "to_if_alone": [
                  {
                    "key_code": "caps_lock",
                    "hold_down_milliseconds": 200
                  }
                ]
              }
            ]
          }
        ]
      },
      "name": "omacosy",
      "selected": true,
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      },
      "devices": [
