+@testable import AppBundle
+import XCTest
+
+final class NativeFocusRequestTest: XCTestCase {
+    private let request = NativeFocusRequest(generation: 2, windowId: 2257, pid: 10, sourcePid: 20, started: 1)
+    func testTargetAcknowledges() {
+        XCTAssertEqual(request.observe(windowId: 2257, pid: 10), .acknowledge)
+    }
+    func testOldWindowInTargetAppIsIntermediate() {
+        XCTAssertEqual(request.observe(windowId: 2260, pid: 10), .intermediate)
+    }
+    func testPreviousAppIsIntermediate() {
+        XCTAssertEqual(request.observe(windowId: 5518, pid: 20), .intermediate)
+    }
+    func testMissingWindowDoesNotAcknowledge() {
+        XCTAssertEqual(request.observe(windowId: nil, pid: 10), .intermediate)
+        XCTAssertEqual(request.observe(windowId: nil, pid: nil), .intermediate)
+    }
+    func testUnrelatedAppSupersedes() {
+        XCTAssertEqual(request.observe(windowId: 654, pid: 30), .superseded)
+    }
+}
+
+@MainActor final class NativeFocusCoordinatorTest: XCTestCase {
+    override func setUp() async throws { setUpWorkspacesForTests() }
+    override func tearDown() async throws {
+        if let request = NativeFocusCoordinator.pending {
+            NativeFocusCoordinator.fail(request.generation, reason: "test-cleanup")
+        }
+    }
+    func testStaleFailureCannotCancelNewRequest() {
+        let revision = NativeFocusCoordinator.observationRevision
+        let old = NativeFocusCoordinator.begin(windowId: 1, pid: 10)
+        XCTAssertNotEqual(revision, NativeFocusCoordinator.observationRevision)
+        let new = NativeFocusCoordinator.begin(windowId: 2, pid: 10)
+        NativeFocusCoordinator.fail(old, reason: "old-error")
+        XCTAssertEqual(NativeFocusCoordinator.pending?.generation, new)
+    }
+    func testOnlyNewUserInputCancelsRequest() {
+        let token = NativeFocusCoordinator.begin(windowId: 1, pid: 10)
+        let started = NativeFocusCoordinator.pending!.started
+        NativeFocusCoordinator.userInput(timestamp: started - 0.1)
+        XCTAssertEqual(NativeFocusCoordinator.pending?.generation, token)
+        NativeFocusCoordinator.userInput(timestamp: started + 0.1)
+        XCTAssertNil(NativeFocusCoordinator.pending)
+    }
+    func testDestroyedTargetReleasesRequest() {
+        _ = NativeFocusCoordinator.begin(windowId: 999999, pid: 10)
+        XCTAssertTrue(NativeFocusCoordinator.accept(nil))
+        XCTAssertNil(NativeFocusCoordinator.pending)
+    }
+}
