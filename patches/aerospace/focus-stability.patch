+import AppKit
+import Common
+
+struct NativeFocusRequest: Equatable {
+    let generation: UInt64
+    let windowId: UInt32
+    let pid: pid_t
+    let sourcePid: pid_t?
+    let started: TimeInterval
+
+    enum Observation { case acknowledge, intermediate, superseded }
+    func observe(windowId: UInt32?, pid: pid_t?) -> Observation {
+        if windowId == self.windowId && pid == self.pid { return .acknowledge }
+        if pid == nil || pid == self.pid || pid == sourcePid { return .intermediate }
+        return .superseded
+    }
+}
+
+@MainActor enum NativeFocusCoordinator {
+    static private(set) var generation: UInt64 = 0
+    static private(set) var observationRevision: UInt64 = 0
+    static private(set) var pending: NativeFocusRequest?
+    private static var deadline: Task<Void, Never>?
+
+    static func begin(windowId: UInt32, pid: pid_t) -> UInt64 {
+        generation &+= 1
+        observationRevision &+= 1
+        deadline?.cancel()
+        let token = generation
+        pending = NativeFocusRequest(generation: token, windowId: windowId, pid: pid,
+            sourcePid: NSWorkspace.shared.frontmostApplication?.processIdentifier,
+            started: ProcessInfo.processInfo.systemUptime)
+        NSLog("AeroSpace focus request=%llu window=%u pid=%d", token, windowId, pid)
+        // Failure deadline, not a focus debounce: a matching AX observation
+        // completes immediately; a refused activation must not pin focus forever.
+        deadline = Task { @MainActor in
+            do { try await Task.sleep(for: .seconds(2)) } catch { return }
+            fail(token, reason: "activation-not-acknowledged")
+        }
+        return token
+    }
+
+    static func fail(_ token: UInt64, reason: String) {
+        guard pending?.generation == token else { return }
+        NSLog("AeroSpace focus request=%llu failed=%@", token, reason)
+        MacApp.cancelNativeFocus()
+        pending = nil
+        observationRevision &+= 1
+        deadline?.cancel()
+        invalidateNativeFocusCache()
+        if !isUnitTest { scheduleCancellableCompleteRefreshSession(.ax("native-focus-failed")) }
+    }
+
+    static func userInput(timestamp: TimeInterval) {
+        if let request = pending, timestamp > request.started {
+            fail(request.generation, reason: "superseded-by-user-input")
+        }
+    }
+
+    static func accept(_ window: Window?) -> Bool {
+        guard let request = pending else { return true }
+        guard Window.get(byId: request.windowId) != nil else {
+            fail(request.generation, reason: "target-closed")
+            return true
+        }
+        let pid = window?.app.pid ?? NSWorkspace.shared.frontmostApplication?.processIdentifier
+        switch request.observe(windowId: window?.windowId, pid: pid) {
+            case .acknowledge:
+                NSLog("AeroSpace focus request=%llu acknowledged window=%u", request.generation, request.windowId)
+                pending = nil
+                observationRevision &+= 1
+                deadline?.cancel()
+                return true
+            case .intermediate:
+                return false
+            case .superseded:
+                fail(request.generation, reason: "another-application-activated")
+                return true
+        }
+    }
+}
