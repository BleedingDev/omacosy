+import AppKit
+
+// An obsolete request must not finish raising its window after a newer one
+// has been submitted. Never fall back to application-wide activation.
+func performNativeWindowFocus(
+    _ job: RunLoopJob,
+    makeMain: () -> Void,
+    makeKey: () throws -> CGError,
+    raise: () -> Void,
+) throws -> CGError {
+    try job.checkCancellation()
+    makeMain()
+    try job.checkCancellation()
+    let result = try makeKey()
+    guard result == .success else { return result }
+    try job.checkCancellation()
+    raise()
+    return .success
+}
+
+// Separate a same-process key-window handoff from application activation.
+// Every phase is cancellable; an old request must not select after a newer one.
+func performKeyWindowHandoff(_ job: RunLoopJob,
+    resign: () -> CGError, settle: () -> Void, select: () -> CGError
+) throws -> CGError {
+    try job.checkCancellation()
+    let result = resign()
+    guard result == .success else { return result }
+    settle()
+    try job.checkCancellation()
+    return select()
+}
