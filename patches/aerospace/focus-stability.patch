+@testable import AppBundle
+import AppKit
+import Common
+import XCTest
+
+final class NativeWindowFocusTest: XCTestCase {
+    func testTargetsWindowBeforeRaising() throws {
+        var events: [String] = []
+        let result = try performNativeWindowFocus(RunLoopJob(.cancellable),
+            makeMain: { events.append("main") },
+            makeKey: { events.append("key"); return .success },
+            raise: { events.append("raise") })
+        XCTAssertEqual(result, .success)
+        XCTAssertEqual(events, ["main", "key", "raise"])
+    }
+
+    func testCancelledRequestDoesNothing() {
+        let job = RunLoopJob(.cancellable)
+        job.cancel()
+        XCTAssertThrowsError(try performNativeWindowFocus(job,
+            makeMain: { XCTFail("cancelled") }, makeKey: { XCTFail("cancelled"); return .success },
+            raise: { XCTFail("cancelled") }))
+    }
+
+    func testCancellationDuringMainSelectionStopsActivation() {
+        let job = RunLoopJob(.cancellable)
+        XCTAssertThrowsError(try performNativeWindowFocus(job,
+            makeMain: { job.cancel() }, makeKey: { XCTFail("obsolete activation"); return .success },
+            raise: { XCTFail("obsolete raise") }))
+    }
+
+    func testCancellationDuringActivationStopsRaise() {
+        let job = RunLoopJob(.cancellable)
+        XCTAssertThrowsError(try performNativeWindowFocus(job,
+            makeMain: {}, makeKey: { job.cancel(); return .success },
+            raise: { XCTFail("obsolete raise") }))
+    }
+
+    func testFailedActivationDoesNotRaiseOrReactivateApp() throws {
+        let result = try performNativeWindowFocus(RunLoopJob(.cancellable),
+            makeMain: {}, makeKey: { .cannotComplete }, raise: { XCTFail("failed activation") })
+        XCTAssertEqual(result, .cannotComplete)
+    }
+
+    func testKeyHandoffOrdersLossBeforeSelection() throws {
+        var events: [String] = []
+        let result = try performKeyWindowHandoff(RunLoopJob(.cancellable),
+            resign: { events.append("resign"); return .success },
+            settle: { events.append("settle") },
+            select: { events.append("select"); return .success })
+        XCTAssertEqual(result, .success)
+        XCTAssertEqual(events, ["resign", "settle", "select"])
+    }
+    func testNewRequestDuringHandoffPreventsStaleSelection() {
+        let job = RunLoopJob(.cancellable)
+        XCTAssertThrowsError(try performKeyWindowHandoff(job,
+            resign: { .success }, settle: { job.cancel() },
+            select: { XCTFail("obsolete selection"); return .success }))
+    }
+    func testFailedResignationDoesNotSelect() throws {
+        XCTAssertEqual(try performKeyWindowHandoff(RunLoopJob(.cancellable),
+            resign: { .cannotComplete }, settle: { XCTFail("failed") },
+            select: { XCTFail("failed"); return .success }), .cannotComplete)
+    }
+}
