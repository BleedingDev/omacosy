-// This file exists purely because xcode doesn't like header only targets, SPM is fine with them
 #import "private.h"
+#import <Carbon/Carbon.h>
+#import <string.h>
+
+// WindowServer key-window protocol shared with yabai/Amethyst.
+// See AeroSpace issue #101 and proposed upstream fix #2179.
+extern CGError _SLPSSetFrontProcessWithOptions(ProcessSerialNumber *, uint32_t, uint32_t);
+extern CGError SLPSPostEventRecordTo(ProcessSerialNumber *, uint8_t *);
+
+CGError aeroMakeKeyWindow(pid_t pid, uint32_t wid) {
+    if (pid <= 0 || wid == 0) return kCGErrorIllegalArgument;
+    ProcessSerialNumber psn = {0};
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    OSStatus status = GetProcessForPID(pid, &psn);
+#pragma clang diagnostic pop
+    if (status != noErr) return kCGErrorCannotComplete;
+    CGError error = _SLPSSetFrontProcessWithOptions(&psn, wid, 0x200);
+    if (error != kCGErrorSuccess) return error;
+    uint8_t bytes[0xf8] = {0};
+    bytes[0x04] = 0xf8;
+    bytes[0x3a] = 0x10;
+    memcpy(bytes + 0x3c, &wid, sizeof(wid));
+    memset(bytes + 0x20, 0xff, 0x10);
+    bytes[0x08] = 0x01;
+    error = SLPSPostEventRecordTo(&psn, bytes);
+    if (error != kCGErrorSuccess) return error;
+    bytes[0x08] = 0x02;
+    return SLPSPostEventRecordTo(&psn, bytes);
+}
+
+CGError aeroPostKeyWindowEvent(pid_t pid, uint32_t wid, bool active) {
+    if (pid <= 0 || wid == 0) return kCGErrorIllegalArgument;
+    ProcessSerialNumber psn = {0};
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    OSStatus status = GetProcessForPID(pid, &psn);
+#pragma clang diagnostic pop
+    if (status != noErr) return kCGErrorCannotComplete;
+    uint8_t bytes[0xf8] = {0};
+    bytes[0x04] = 0xf8;
+    bytes[0x08] = 0x0d;
+    bytes[0x8a] = active ? 0x01 : 0x02;
+    memcpy(bytes + 0x3c, &wid, sizeof(wid));
+    return SLPSPostEventRecordTo(&psn, bytes);
+}
