+// AppKit moves the same AXTabGroup element between the selected NSWindows.
+// Inactive tabs lose AXChildren, so only AXWindows-enumerated live windows may
+// clear membership. Detached and independently created windows have no group.
+private func observeNativeTabGroups(windows: [UInt32: AxWindow], selected: [WindowIdAndAxUiElement]) -> NativeTabSnapshot {
+    var identities = windows.values.compactMap { $0.nativeTabGroup }
+    var result: [NativeTabObservation] = []
+    var updates: [(AxWindow, (AXUIElement, UUID)?)] = []
+    for (id, ax) in selected.sorted(by: { $0.0 < $1.0 }) {
+        guard let window = windows[id] else { continue }
+        var value: CFTypeRef?
+        guard unsafe AXUIElementCopyAttributeValue(ax, kAXChildrenAttribute as CFString, &value) == .success,
+              let children = value as? [AXUIElement] else { return .unavailable }
+        var element: AXUIElement?
+        for child in children {
+            guard let role = child.get(Ax.roleAttr) else { return .unavailable }
+            if role == "AXTabGroup" { element = child; break }
+        }
+        guard let element else {
+            updates.append((window, nil))
+            result.append(NativeTabObservation(windowId: id, group: nil))
+            continue
+        }
+        let group = identities.first(where: { CFEqual($0.0, element) })?.1 ?? UUID()
+        updates.append((window, (element, group)))
+        identities.append((element, group))
+        result.append(NativeTabObservation(windowId: id, group: group))
+    }
+    // Commit native identities only after the complete external read succeeds.
+    for (window, group) in updates { window.nativeTabGroup = group }
+    return .available(result)
+}
