+@testable import AppBundle
+import Foundation
+import XCTest
+
+final class NativeTabWorkspacesTest: XCTestCase {
+    func testSelectedAndPreviouslyObservedTabsMoveTogether() {
+        let group = UUID()
+        var state = NativeTabWorkspaces()
+        XCTAssertEqual(state.observe(windowId: 10, group: group, workspace: "1"), "1")
+        XCTAssertEqual(state.observe(windowId: 11, group: group, workspace: "2"), "1")
+        XCTAssertEqual(state.move(windowId: 11, to: "3"), [10, 11])
+        XCTAssertEqual(state.observe(windowId: 10, group: group, workspace: "1"), "3")
+    }
+
+    func testTabFirstDiscoveredAfterMoveAdoptsGroupDestination() {
+        let group = UUID()
+        var state = NativeTabWorkspaces()
+        _ = state.observe(windowId: 10, group: group, workspace: "1")
+        XCTAssertEqual(state.move(windowId: 10, to: "13"), [10])
+        XCTAssertEqual(state.observe(windowId: 12, group: group, workspace: "1"), "13")
+        XCTAssertEqual(state.move(windowId: 12, to: "3"), [10, 12])
+    }
+
+    func testIndependentWindowAndOtherTabGroupStayIndependent() {
+        let group = UUID(), other = UUID()
+        var state = NativeTabWorkspaces()
+        _ = state.observe(windowId: 10, group: group, workspace: "1")
+        _ = state.observe(windowId: 20, group: other, workspace: "1")
+        XCTAssertNil(state.observe(windowId: 30, group: nil, workspace: "1"))
+        XCTAssertEqual(state.move(windowId: 10, to: "3"), [10])
+        XCTAssertEqual(state.observe(windowId: 20, group: other, workspace: "1"), "1")
+        XCTAssertEqual(state.move(windowId: 30, to: "4"), [30])
+    }
+
+    func testDetachedTabStopsFollowingItsFormerGroup() {
+        let group = UUID()
+        var state = NativeTabWorkspaces()
+        _ = state.observe(windowId: 10, group: group, workspace: "1")
+        _ = state.observe(windowId: 11, group: group, workspace: "1")
+        XCTAssertNil(state.observe(windowId: 11, group: nil, workspace: "1"))
+        XCTAssertEqual(state.move(windowId: 10, to: "3"), [10])
+        XCTAssertEqual(state.move(windowId: 11, to: "4"), [11])
+    }
+
+    func testMovingTabBetweenGroupsReplacesItsMembership() {
+        let group = UUID(), other = UUID()
+        var state = NativeTabWorkspaces()
+        _ = state.observe(windowId: 10, group: group, workspace: "1")
+        _ = state.observe(windowId: 11, group: group, workspace: "1")
+        _ = state.observe(windowId: 20, group: other, workspace: "2")
+        XCTAssertEqual(state.observe(windowId: 11, group: other, workspace: "1"), "2")
+        XCTAssertEqual(state.move(windowId: 10, to: "3"), [10])
+        XCTAssertEqual(state.move(windowId: 20, to: "4"), [11, 20])
+    }
+
+    func testUnavailableSnapshotPreservesMembershipAndRejectsSynchronization() {
+        let group = UUID()
+        var state = NativeTabWorkspaces()
+        _ = state.observe(windowId: 10, group: group, workspace: "1")
+        _ = state.observe(windowId: 11, group: group, workspace: "1")
+        XCTAssertNil(state.synchronize(.unavailable, workspaces: [10: "1", 11: "1"]))
+        // A later successful observation still recovers the original group.
+        XCTAssertEqual(state.observe(windowId: 12, group: group, workspace: "2"), "1")
+        XCTAssertEqual(state.move(windowId: 12, to: "3"), [10, 11, 12])
+    }
+
+    func testSuccessfulStandaloneSnapshotClearsFormerMembership() {
+        let group = UUID()
+        var state = NativeTabWorkspaces()
+        _ = state.observe(windowId: 10, group: group, workspace: "1")
+        _ = state.observe(windowId: 11, group: group, workspace: "1")
+        let snapshot = NativeTabSnapshot.available([NativeTabObservation(windowId: 11, group: nil)])
+        XCTAssertEqual(state.synchronize(snapshot, workspaces: [10: "1", 11: "1"]), [:])
+        XCTAssertEqual(state.move(windowId: 10, to: "3"), [10])
+        XCTAssertEqual(state.move(windowId: 11, to: "4"), [11])
+    }
+
+}
