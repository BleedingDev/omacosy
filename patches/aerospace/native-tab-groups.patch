@@ -0,0 +1,33 @@
+import Foundation
+
+struct NativeTabObservation: Sendable {
+    let windowId: UInt32
+    let group: UUID?
+}
+
+// A native tab group owns one workspace. Its selected NSWindow can change,
+// and some siblings are first discovered only when selected later.
+struct NativeTabWorkspaces {
+    private var membership: [UInt32: UUID] = [:]
+    private var workspaces: [UUID: String] = [:]
+
+    mutating func observe(windowId: UInt32, group: UUID?, workspace: String) -> String? {
+        if membership[windowId] != group { forget(windowId: windowId) }
+        guard let group else { return nil }
+        membership[windowId] = group
+        let destination = workspaces[group] ?? workspace
+        workspaces[group] = destination
+        return destination
+    }
+
+    mutating func move(windowId: UInt32, to workspace: String) -> Set<UInt32> {
+        guard let group = membership[windowId] else { return [windowId] }
+        workspaces[group] = workspace
+        return Set(membership.filter { $0.value == group }.keys)
+    }
+
+    mutating func forget(windowId: UInt32) {
+        guard let group = membership.removeValue(forKey: windowId) else { return }
+        if !membership.values.contains(group) { workspaces[group] = nil }
+    }
+}
